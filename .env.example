# Copy to .env.local for local development. Never commit a real .env file.
#
# Everything below is NEXT_PUBLIC_*, which Next.js inlines into the browser
# bundle at build time. Only put values here that are safe to ship to a client.
# A server-held API key must never carry the NEXT_PUBLIC_ prefix.

# Which client backs the app: "mock" (default) or "live".
# The demo runs on "mock" — a fully-built in-browser implementation with seeded
# data. "live" points at the real gateway, and is still incomplete: several
# methods deliberately throw NOT_IMPLEMENTED rather than fake a result.
NEXT_PUBLIC_API_MODE=mock

# Gateway base URL, used only when NEXT_PUBLIC_API_MODE=live. No default —
# set this to the gateway your API key belongs to, or to your own route
# handler under /api. Live mode is incomplete; see the README's "What's real".
NEXT_PUBLIC_API_BASE_URL=

# Sent as the X-Environment header in live mode.
NEXT_PUBLIC_THIQWAVE_ENV=dev

# Sent as the X-Application-Id header in live mode. Leave empty if unused.
NEXT_PUBLIC_THIQWAVE_APP_ID=
